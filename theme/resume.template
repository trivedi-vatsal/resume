<!DOCTYPE html>
<html lang="en" data-theme="ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{{ basics.label }} - {{ basics.name }}" />
    <meta name="author" content="{{ basics.name }}" />
    <title>{{ basics.name }} - Resume</title>
    <style>{{{css}}}</style>
    <style media="print">{{{printcss}}}</style>
  </head>
  <body>
    <nav class="resume-controls" aria-label="Resume actions">
      <a href="./pdf/{{ basics.name }}.pdf">Download PDF</a>
    </nav>
    <main class="resume">
      <header class="resume-header">
        <h1>{{ basics.name }}</h1>
        {{#basics.label}}<p class="headline">{{ basics.label }}</p>{{/basics.label}}
        <div class="contact-line">
          {{#basics.location}}<span>{{ city }}{{#region}}, {{ region }}{{/region}}</span>{{/basics.location}}
          {{#basics.email}}<a href="mailto:{{ basics.email }}">{{ basics.email }}</a>{{/basics.email}}
          {{#basics.phone}}<a href="tel:{{ basics.phone }}">{{ basics.phone }}</a>{{/basics.phone}}
          {{#basics.url}}<a href="{{ basics.url }}">{{ basics.url }}</a>{{/basics.url}}
        </div>
        <div class="profile-line">
          {{#basics.profiles}}<a href="{{ url }}" aria-label="{{ network }} profile for {{ username }}" title="{{ network }}">{{#iconSvg}}{{{ iconSvg }}}{{/iconSvg}}{{^iconSvg}}<span>{{ network }}</span>{{/iconSvg}}<span>{{#username}}{{ username }}{{/username}}{{^username}}{{ url }}{{/username}}</span></a>{{/basics.profiles}}
        </div>
      </header>

      {{#basics.summary}}
      <section class="resume-section profile-section">
        <h2>Profile</h2>
        <p>{{{ basics.formattedSummary }}}</p>
      </section>
      {{/basics.summary}}

      {{#basics.focusAreas}}
      <p class="focus-areas"><strong>Focus areas</strong> {{ basics.focusAreas }}</p>
      {{/basics.focusAreas}}

      {{#workBool}}
      <section class="resume-section experience-section">
        <h2>Experience</h2>
        {{#work}}
        <article class="work-entry">
          <header class="entry-heading">
            <div class="company-line">
              <h3>{{#url}}<a href="{{ url }}">{{ name }}</a>{{/url}}{{^url}}{{ name }}{{/url}}</h3>
              {{#location}}<span class="entry-location">{{ location }}</span>{{/location}}
            </div>
            <div class="role-line">
              <h4>{{ position }}</h4>
              <span class="entry-date">{{ startDateMonth }}{{ startDateYear }} - {{ endDateMonth }}{{ endDateYear }}</span>
            </div>
            {{#description}}<p class="company-description">{{ description }}</p>{{/description}}
          </header>
          {{#summary}}<p class="role-summary">{{{ summary }}}</p>{{/summary}}
          {{#boolHighlights}}
          <ul class="achievements">
            {{#formattedHighlights}}<li>{{{ . }}}</li>{{/formattedHighlights}}
          </ul>
          {{/boolHighlights}}
        </article>
        {{/work}}
      </section>
      {{/workBool}}

      {{#projectsBool}}
      <section class="resume-section projects-section">
        <h2>Projects I built</h2>
        <p>Personal projects and developer tools I built, including open-source software.</p>
        {{#projects}}
        <article class="project-entry">
          <header class="project-heading">
            <h3>{{#url}}<a href="{{ url }}">{{ name }}</a>{{/url}}{{^url}}{{ name }}{{/url}}</h3>
            {{#displayUrl}}<a class="project-url" href="{{ url }}">{{ displayUrl }}</a>{{/displayUrl}}
          </header>
          <p>{{{ formattedDescription }}}</p>
          {{#boolHighlights}}
          <ul class="project-highlights">
            {{#highlights}}<li>{{{ . }}}</li>{{/highlights}}
          </ul>
          {{/boolHighlights}}
          <div class="technology-line">{{#keywords}}<span>{{ . }}</span>{{/keywords}}</div>
        </article>
        {{/projects}}
      </section>
      {{/projectsBool}}

      {{#skillsBool}}
      <section class="resume-section skills-section">
        <h2>Skills</h2>
        <dl class="skills-list">
          {{#skills}}
          <div class="skill-group">
            <dt>{{ name }}</dt>
            <dd>{{#keywords}}<span>{{ . }}</span>{{/keywords}}</dd>
          </div>
          {{/skills}}
        </dl>
      </section>
      {{/skillsBool}}

      {{#educationBool}}
      <section class="resume-section education-section">
        <h2>Education</h2>
        {{#education}}
        <article class="education-entry">
          <div class="role-line">
            <h3>{{ studyType }}{{#area}}, {{ area }}{{/area}}</h3>
            <span class="entry-date">{{ startDateYear }} - {{ endDateYear }}</span>
          </div>
          <p>{{#url}}<a href="{{ url }}">{{ institution }}</a>{{/url}}{{^url}}{{ institution }}{{/url}}</p>
          {{#score}}<p class="entry-note">Grade: {{ score }}</p>{{/score}}
          {{#educationCourses}}<div class="technology-line">{{#courses}}<span>{{ . }}</span>{{/courses}}</div>{{/educationCourses}}
        </article>
        {{/education}}
      </section>
      {{/educationBool}}

      {{#awardsBool}}
      <section class="resume-section">
        <h2>Awards</h2>
        {{#awards}}
        <article class="education-entry">
          <div class="role-line"><h3>{{ title }}</h3><span class="entry-date">{{ month }} {{ year }}</span></div>
          <p>{{ awarder }}</p>
          {{#summary}}<p>{{{ summary }}}</p>{{/summary}}
        </article>
        {{/awards}}
      </section>
      {{/awardsBool}}

      {{#volunteerBool}}
      <section class="resume-section volunteer-section">
        <h2>Community</h2>
        {{#volunteer}}
        <article class="education-entry">
          <div class="role-line"><h3>{{ position }} - {{ organization }}</h3><span class="entry-date">{{ startDateYear }} - {{ endDateYear }}</span></div>
          {{#summary}}<p>{{{ summary }}}</p>{{/summary}}
          {{#boolHighlights}}<ul class="achievements">{{#highlights}}<li>{{{ . }}}</li>{{/highlights}}</ul>{{/boolHighlights}}
        </article>
        {{/volunteer}}
      </section>
      {{/volunteerBool}}

      {{#certificatesBool}}<section class="resume-section"><h2>Certificates</h2>{{#certificates}}<p>{{ name }}{{#issuer}} - {{ issuer }}{{/issuer}}</p>{{/certificates}}</section>{{/certificatesBool}}
      {{#publicationsBool}}<section class="resume-section"><h2>Publications</h2>{{#publications}}<article class="education-entry"><h3>{{#url}}<a href="{{ url }}">{{ name }}</a>{{/url}}{{^url}}{{ name }}{{/url}}</h3><p>{{ publisher }}</p>{{#summary}}<p>{{{ summary }}}</p>{{/summary}}</article>{{/publications}}</section>{{/publicationsBool}}
      {{#languagesBool}}<section class="resume-section"><h2>Languages</h2><div class="technology-line">{{#languages}}<span>{{ language }} - {{ fluency }}</span>{{/languages}}</div></section>{{/languagesBool}}
      {{#interestsBool}}<section class="resume-section"><h2>Interests</h2><div class="technology-line">{{#interests}}<span>{{ name }}</span>{{/interests}}</div></section>{{/interestsBool}}
      {{#referencesBool}}<section class="resume-section"><h2>References</h2>{{#references}}<blockquote><p>{{{ reference }}}</p><footer>{{ name }}</footer></blockquote>{{/references}}</section>{{/referencesBool}}
    </main>
  </body>
</html>
